<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — проекты</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { active: 'houses', newRequestsCount }) %>

  <main class="container admin-main">
    <% if (saved) { %>
      <div class="alert alert-success">Изменения сохранены.</div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="admin-section-header">
      <h2 class="admin-section-title">Карточки домов</h2>
      <span class="admin-section-count"><%= content.houses.length %> шт., на главной — <%= content.houses.filter(function(h) { return h.showOnHome !== false; }).length %></span>
    </div>

    <% if (content.houses.length > 0) { %>
      <div class="admin-pager" id="housePager">
        <button type="button" class="admin-pager__nav" id="housePagerPrev" aria-label="Предыдущий дом">‹</button>
        <div class="admin-pager__list" id="housePagerList">
          <% content.houses.forEach(function(house, i) { %>
            <button type="button" class="admin-pager__item <%= i === 0 ? 'is-active' : '' %>" data-house-id="<%= house.id %>">
              <% if (house.showOnHome !== false) { %><span class="admin-home-mark" title="Показывается на главной">★</span><% } %>
              <%= house.title %>
            </button>
          <% }); %>
        </div>
        <button type="button" class="admin-pager__nav" id="housePagerNext" aria-label="Следующий дом">›</button>
        <span class="admin-pager__counter" id="housePagerCounter">1 / <%= content.houses.length %></span>
      </div>
    <% } %>

    <div class="admin-houses-list" id="housePages">
      <% content.houses.forEach(function(house, i) { %>
        <section class="admin-card admin-house-card" data-house-id="<%= house.id %>" <%= i !== 0 ? 'hidden' : '' %>>
          <div class="admin-house-config">
            <a href="/admin/house/<%= encodeURIComponent(house.id) %>/inclusions" class="btn btn-outline btn-small">Настроить «Что входит в стоимость»</a>
          </div>
          <section class="admin-house-estimate" aria-labelledby="house-estimate-<%= house.id %>">
            <div class="admin-house-estimate__header">
              <h3 id="house-estimate-<%= house.id %>">Привязка расчёта сметы</h3>
              <a class="btn btn-outline btn-small" href="/admin/house/<%= encodeURIComponent(house.id) %>/presentation.zip">Скачать презентацию</a>
            </div>
            <% const linkedRun = estimateRuns.find((run) => run.id === house.estimateRunId); %>
            <% if (estimateRuns.length || house.estimateRunId) { %>
              <form method="POST" action="/admin/house/<%= house.id %>/estimate" class="admin-upload-form admin-house-estimate__form">
                <%- include('../partials/admin-house-estimate', { estimateRuns, selectedRunId: house.estimateRunId }) %>
                <div class="admin-form-actions">
                  <button type="submit" class="btn btn-accent btn-small">Закрепить расчёт</button>
                  <% if (linkedRun) { %>
                    <a class="btn btn-outline btn-small" href="/admin/estimate-runs/<%= encodeURIComponent(linkedRun.id) %>">Открыть расчёт</a>
                  <% } %>
                </div>
              </form>
            <% } %>
            <% if (!estimateRuns.length) { %>
              <p class="field-hint">Сохраните расчёт, чтобы выбрать его для проекта.</p>
              <a class="btn btn-outline btn-small" href="/admin/estimate-runs">Перейти к расчётам</a>
            <% } %>
          </section>
          <div class="admin-card__row">
            <% const media = projectMedia(house); %>
            <div>
              <img class="admin-preview admin-preview--house" src="<%= media.cover %>" alt="<%= house.title %>">
              <p class="field-hint">Обложка на сайте<%= media.illustrated ? ' · Визуализация' : '' %></p>
            </div>
            <form method="POST" action="/admin/house/<%= house.id %>" enctype="multipart/form-data" class="admin-upload-form">
              <label>Название
                <input type="text" name="title" value="<%= house.title %>" required>
              </label>
              <div class="admin-form-grid">
                <label>Площадь
                  <input type="text" name="area" value="<%= house.area %>">
                </label>
                <label>Цена
                  <input type="text" name="price" value="<%= house.price %>">
                </label>
              </div>
              <label>Короткое описание <span class="field-hint">(в карточке на главной)</span>
                <textarea name="description" rows="2"><%= house.description %></textarea>
              </label>
              <label>Полное описание <span class="field-hint">(на странице дома)</span>
                <textarea name="fullDescription" rows="4"><%= house.fullDescription || '' %></textarea>
              </label>
              <%- include('../partials/admin-house-parameters', { fields: getHouseParameterFields(house, content.calculator) }) %>
              <label>Дополнительные характеристики <span class="field-hint">(по одной на строку, формат «Метка: Значение»)</span>
                <textarea name="specs" rows="5" class="specs-textarea" placeholder="Спальни: 3&#10;Санузлы: 2&#10;Площадь участка: от 8 соток"><%= (house.specs || []).map(function(s) { return s.label + ': ' + s.value; }).join('\n') %></textarea>
              </label>
              <input type="hidden" name="showOnHomeField" value="1">
              <label class="admin-checkbox">
                <input type="checkbox" name="showOnHome" value="1" <%= house.showOnHome !== false ? 'checked' : '' %>>
                Показывать на главной странице <span class="field-hint">(без галочки — только во вкладке «Все проекты»)</span>
              </label>
              <label>Заменить главное изображение
                <input type="file" name="image" accept="image/*">
              </label>
              <div class="admin-form-actions">
                <button type="submit" class="btn btn-accent btn-small">Сохранить</button>
              </div>
            </form>
          </div>

          <div class="admin-gallery-section">
            <h4>Галерея (фото на странице дома)</h4>
            <% if (house.gallery && house.gallery.length > 0) { %>
              <div class="admin-gallery-grid">
                <% house.gallery.forEach(function(photo, i) { %>
                  <div class="admin-gallery-item">
                    <img src="<%= photo %>" alt="Фото <%= i + 1 %>">
                    <form method="POST" action="/admin/house/<%= house.id %>/gallery/<%= i %>/delete"
                          data-confirm-delete="Удалить это фото из галереи?">
                      <button type="submit" class="btn btn-danger btn-small">Удалить</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="admin-empty admin-empty--small">Фотографий пока нет.</p>
            <% } %>
            <form method="POST" action="/admin/house/<%= house.id %>/gallery" enctype="multipart/form-data" class="admin-gallery-upload">
              <label>Добавить фото <span class="field-hint">(можно выбрать сразу несколько)</span>
                <input type="file" name="images" accept="image/*" multiple required>
              </label>
              <button type="submit" class="btn btn-outline btn-small">Загрузить в галерею</button>
            </form>
          </div>

          <form method="POST" action="/admin/house/<%= house.id %>/delete"
                class="admin-delete-form"
                data-confirm-delete="Удалить дом «<%= house.title %>»? Это действие нельзя отменить.">
            <button type="submit" class="btn btn-danger btn-small">Удалить дом полностью</button>
          </form>
        </section>
      <% }); %>
    </div>

    <section class="admin-card admin-card--new">
      <h3 class="admin-new-title">+ Добавить новый дом</h3>
        <form method="POST" action="/admin/house" enctype="multipart/form-data" class="admin-upload-form">
          <label>Название *
            <input type="text" name="title" placeholder="Например, Дом «Терраса»" required>
          </label>
          <div class="admin-form-grid">
            <label>Площадь
              <input type="text" name="area" placeholder="120 м²">
            </label>
            <label>Цена
              <input type="text" name="price" placeholder="от 5 000 000 ₽">
            </label>
          </div>
          <%- include('../partials/admin-house-estimate', { estimateRuns, selectedRunId: undefined }) %>
          <label>Короткое описание <span class="field-hint">(в карточке на главной)</span>
            <textarea name="description" rows="2" placeholder="Короткое описание проекта"></textarea>
          </label>
          <label>Полное описание <span class="field-hint">(на странице дома)</span>
            <textarea name="fullDescription" rows="4" placeholder="Развёрнутое описание проекта"></textarea>
          </label>
          <%- include('../partials/admin-house-parameters', { fields: getHouseParameterFields({}, content.calculator) }) %>
          <label>Дополнительные характеристики <span class="field-hint">(по одной на строку, формат «Метка: Значение»)</span>
            <textarea name="specs" rows="5" class="specs-textarea" placeholder="Спальни: 3&#10;Санузлы: 2&#10;Площадь участка: от 8 соток"></textarea>
          </label>
          <label class="admin-checkbox">
            <input type="checkbox" name="showOnHome" value="1">
            Показывать на главной странице <span class="field-hint">(без галочки — только во вкладке «Все проекты»)</span>
          </label>
          <label>Изображение
            <input type="file" name="image" accept="image/*">
          </label>
          <div class="admin-form-actions">
            <button type="submit" class="btn btn-accent btn-small">Добавить дом</button>
          </div>
          <p class="field-hint">Фотографии галереи можно будет добавить сразу после создания дома — ниже в списке.</p>
        </form>
    </section>
  </main>

  <script src="/js/confirm-delete.js"></script>
  <script src="/js/admin-house-pager.js"></script>
</body>
</html>

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — шаблоны смет</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { active: 'estimates', newRequestsCount }) %>

  <main class="container admin-main">
    <div class="admin-section-header admin-section-header--wide">
      <h2 class="admin-section-title">Шаблоны смет</h2>
      <div class="estimate-editor-links">
        <a class="btn btn-outline btn-small" href="/admin/estimate-runs">К расчёту смет</a>
        <a class="btn btn-accent btn-small" href="/admin/estimates/new">Создать шаблон</a>
      </div>
    </div>

    <% if (!estimates.length) { %>
      <p>Сохранённых шаблонов пока нет.</p>
    <% } %>
    <% estimates.forEach(function(estimate) {
      const estimateId = encodeURIComponent(estimate.id);
      const error = copyError?.id === estimate.id ? copyError : null;
    %>
      <article class="admin-card estimate-list-item">
        <h3><a href="/admin/estimates/<%= estimateId %>"><%= estimate.title %></a></h3>
        <details class="estimate-template-copy"<%= error ? ' open' : '' %>>
          <summary class="btn btn-outline btn-small">Скопировать шаблон</summary>
          <form class="admin-upload-form" method="post" action="/admin/estimates/<%= estimateId %>/copy">
            <% if (error) { %>
              <div class="alert alert-error" role="alert" id="estimate-copy-error-<%= estimateId %>"><%= error.message %></div>
            <% } %>
            <label>Уникальное название копии
              <input type="text" name="title" value="<%= error?.title || '' %>" required
                     <% if (error) { %>aria-invalid="true" aria-describedby="estimate-copy-error-<%= estimateId %>" autofocus<% } %>>
            </label>
            <button type="submit" class="btn btn-accent btn-small">Создать копию</button>
          </form>
        </details>
      </article>
    <% }); %>
  </main>
</body>
</html>

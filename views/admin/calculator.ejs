<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — подбор проектов</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { active: 'calculator', newRequestsCount }) %>
  <%
    var calc = content.calculator || { title: '', intro: '', note: '', area: { min: 60, max: 400 }, blocks: [] };
  %>

  <main class="container admin-main">
    <% if (saved) { %>
      <div class="alert alert-success">Изменения сохранены.</div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="admin-section-header">
      <h2 class="admin-section-title">Подбор проектов</h2>
      <a href="/calculator" target="_blank" class="btn btn-outline btn-small">Открыть на сайте ↗</a>
    </div>

    <section class="admin-card calc-admin-help">
      <strong>Как подбираются проекты:</strong>
      <ul>
        <li>Площадь дома должна попадать в выбранный посетителем диапазон, включая обе границы.</li>
        <li>Выбранные характеристики сравниваются с параметрами в разделе <a href="/admin/houses">«Проекты»</a>. Значение «Не важно» пропускает фильтр.</li>
        <li>Если выбрано несколько дополнительных опций, у проекта должны быть все они. Пустой блок не влияет на подбор.</li>
      </ul>
    </section>

    <p><a href="/admin/calculator/directory" class="btn btn-outline btn-small">Справочник калькулятора</a></p>

    <h3 class="calc-admin-subtitle">Общие настройки</h3>
    <section class="admin-card">
      <form method="POST" action="/admin/calculator/settings" class="admin-upload-form">
        <label>Заголовок страницы
          <input type="text" name="title" value="<%= calc.title %>" required>
        </label>
        <label>Подзаголовок
          <textarea name="intro" rows="2"><%= calc.intro %></textarea>
        </label>
        <label>Примечание под списком проектов <span class="field-hint">(мелким шрифтом)</span>
          <textarea name="note" rows="2"><%= calc.note %></textarea>
        </label>
        <div class="admin-form-grid calc-admin-area">
          <label>Площадь от, м²<input type="number" name="areaMin" value="<%= calc.area.min %>" min="1" required></label>
          <label>Площадь до, м²<input type="number" name="areaMax" value="<%= calc.area.max %>" min="2" required></label>
        </div>
        <div class="admin-form-actions">
          <button type="submit" class="btn btn-accent btn-small">Сохранить настройки</button>
        </div>
      </form>
    </section>

  </main>
</body>
</html>

<details class="admin-card admin-public-preview">
  <summary>Предпросмотр страницы на сайте</summary>
  <div class="admin-form-actions admin-public-preview__actions">
    <a href="<%= publicPath %>" class="btn btn-outline btn-small" target="_blank" rel="noopener">Открыть страницу в новой вкладке</a>
  </div>
  <iframe class="admin-public-preview__frame" src="<%= publicPath %>" title="<%= pageTitle %> на сайте" loading="lazy"></iframe>
</details>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">Топ<span>5</span>Домов</a>
    <% const currentPage = typeof activePage === 'undefined' ? '' : activePage; %>
    <nav class="main-nav" aria-label="Основная навигация">
      <%- include('header-links', { currentPage }) %>
    </nav>
    <details class="mobile-nav">
      <summary>Меню</summary>
      <nav class="mobile-nav__links" aria-label="Основная навигация">
        <%- include('header-links', { currentPage }) %>
      </nav>
    </details>
    <a class="phone" href="tel:<%= content.contacts.phone.replace(/[^+\d]/g, '') %>"><%= content.contacts.phone %></a>
  </div>
</header>

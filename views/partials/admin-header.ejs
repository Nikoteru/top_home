<header class="admin-header">
  <div class="container admin-header-inner">
    <span class="logo">Админка</span>
    <nav class="admin-nav">
      <a href="/admin/houses" class="<%= active === 'houses' ? 'is-active' : '' %>">Проекты</a>
      <a href="/admin/portfolio" class="<%= active === 'portfolio' ? 'is-active' : '' %>">Портфолио</a>
      <a href="/admin/stages" class="<%= active === 'stages' ? 'is-active' : '' %>">Этапы стройки</a>
      <a href="/admin/calculator" class="<%= active === 'calculator' ? 'is-active' : '' %>">Подбор проектов</a>
      <a href="/admin/calculator/directory" class="<%= active === 'calculatorDirectory' ? 'is-active' : '' %>">Справочник</a>
      <a href="/admin/home" class="<%= active === 'home' ? 'is-active' : '' %>">Главная страница</a>
      <a href="/admin/contacts" class="<%= active === 'contacts' ? 'is-active' : '' %>">Контакты</a>
      <a href="/admin/requests" class="<%= active === 'requests' ? 'is-active' : '' %>">
        Обращения
        <% if (newRequestsCount > 0) { %>
          <span class="admin-badge"><%= newRequestsCount %></span>
        <% } %>
      </a>
      <a href="/admin/settings" class="<%= active === 'settings' ? 'is-active' : '' %>">Настройки</a>
    </nav>
    <div class="admin-header-actions">
      <a href="/" target="_blank" class="btn btn-outline btn-small">Открыть сайт</a>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="btn btn-ghost btn-small">Выйти</button>
      </form>
    </div>
  </div>
</header>

<section id="form" class="cta">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2><%= ctaTitle %></h2>
      <p><%= ctaText %></p>
    </div>
    <form class="cta-form" action="/request" method="POST" data-lead-form novalidate>
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <% if (typeof withCalc !== 'undefined' && withCalc) { %>
        <input type="hidden" name="calc" id="calcField" value="<%= typeof calcValue !== 'undefined' ? calcValue : '' %>">
      <% } %>
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Телефон: +7 (___) ___-__-__" inputmode="tel">
      <input type="email" name="email" placeholder="E-mail">
      <p class="cta-form__hint" data-form-hint>Укажите телефон или e-mail — достаточно одного варианта.</p>
      <button type="submit" class="btn btn-accent">Отправить заявку</button>
      <p class="cta-form__note">Нажимая кнопку, вы соглашаетесь с обработкой персональных данных.</p>
    </form>
  </div>
  <% if (sent) { %>
    <div class="toast" id="toast">Спасибо! Ваша заявка отправлена, мы скоро свяжемся с вами.</div>
  <% } %>
  <% if (formError) { %>
    <div class="toast toast--error" id="toastError">Проверьте телефон/e-mail — укажите хотя бы одно поле в правильном формате.</div>
  <% } %>
</section>

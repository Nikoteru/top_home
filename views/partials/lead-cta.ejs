<section id="form" class="container cta" aria-labelledby="request-title">
  <div class="cta-inner">
    <div class="cta-text">
      <h2 id="request-title"><%= ctaTitle %></h2>
      <p><%= ctaText %></p>
    </div>
    <form class="cta-form" action="/request" method="POST" data-lead-form novalidate>
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <% if (typeof withCalc !== 'undefined' && withCalc) { %>
        <input type="hidden" name="calc" id="calcField" value="<%= typeof calcValue !== 'undefined' ? calcValue : '' %>">
      <% } %>
      <%- include('lead-contact-fields') %>
      <p class="cta-form__hint" data-form-hint aria-live="polite">Укажите телефон или e-mail — достаточно одного варианта.</p>
      <% if (sent) { %>
        <div class="toast" id="toast" role="status">Спасибо! Ваша заявка отправлена, мы скоро свяжемся с вами.</div>
      <% } %>
      <% if (formError) { %>
        <div class="toast toast--error" id="toastError" role="alert">Укажите имя и проверьте телефон или e-mail.</div>
      <% } %>
      <button type="submit" class="btn btn-accent">Отправить заявку</button>
      <p class="cta-form__note">Нажимая кнопку, вы соглашаетесь с обработкой персональных данных.</p>
    </form>
  </div>
</section>

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content.hero.title %></title>
  <meta name="description" content="<%= content.hero.subtitle %>">
  <%- include('partials/public-styles') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="hero container" aria-labelledby="home-title">
      <div class="hero-frame">
        <img class="hero-media" src="<%= illustratedHero ? '/images/site/hero.webp' : content.hero.image %>" alt="" fetchpriority="high">
        <div class="hero-inner">
          <h1 id="home-title"><%= content.hero.title %></h1>
          <p class="hero-subtitle"><%= content.hero.subtitle %></p>
          <div class="hero-actions">
            <a href="#houses" class="btn btn-accent">Смотреть проекты</a>
            <a href="#form" class="btn btn-outline">Получить презентацию проектов</a>
          </div>
        </div>
        <% if (illustratedHero) { %><span class="media-caption">Архитектурная визуализация</span><% } %>
      </div>
    </section>

    <section id="houses" class="houses container" aria-labelledby="home-projects-title">
      <div class="home-section-head">
        <h2 class="section-title" id="home-projects-title"><%= homeHeadings.projects %></h2>
        <p>Одноэтажный дом — это удобство без лестниц, единое пространство для всей семьи и простая эксплуатация.
          Мы собрали пять современных проектов площадью от 84 до 178 м², которые сочетают продуманную планировку,
          светлые интерьеры и энергоэффективные технологии строительства.</p>
      </div>
      <div class="houses-grid">
        <% homeHouses.forEach(function(house) { %>
          <%- include('partials/project-card', { house, showDescription: true }) %>
        <% }); %>
      </div>
      <div class="houses-more"><a href="/projects" class="btn btn-outline">Смотреть все проекты</a></div>
    </section>

    <section id="advantages" class="advantages" aria-labelledby="home-advantages-title">
      <div class="container">
        <h2 class="section-title" id="home-advantages-title"><%= homeHeadings.advantages %></h2>
        <div class="advantages-grid">
          <% advantages.forEach(function(adv) { %>
            <div class="advantage-card">
              <% if (adv.image) { %><img class="advantage-icon" src="<%= adv.image %>" alt="" loading="lazy"><% } %>
              <h3><%= adv.title %></h3>
              <p><%= adv.text %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <%- include('partials/lead-cta', {
      ctaTitle: homeHeadings.request,
      ctaText: 'Оставьте заявку — пришлём планировки, цены и сроки строительства по каждому дому из подборки.',
      returnTo: '/',
    }) %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/form-validation.js"></script>
</body>
</html>

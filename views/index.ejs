<!doctype html>
<%
  const { hero, headings: homeHeadings, projects: homeHouses, stages: homeStages,
    portfolio: homePortfolio, advantages, design } = homepage;
%>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hero.title %></title>
  <meta name="description" content="<%= hero.subtitle %>">
  <%- include('partials/public-styles') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-frame">
        <img class="hero-media" src="<%= hero.image %>" alt="" fetchpriority="high">
        <div class="hero-inner">
          <div class="hero-copy">
            <h1 id="home-title"><%= hero.title %></h1>
            <% if (hero.subtitle) { %><p class="hero-subtitle"><%= hero.subtitle %></p><% } %>
            <div class="hero-actions">
              <a href="<%= homeHouses.length ? '#houses' : '/projects' %>" class="btn btn-accent">Смотреть проекты</a>
              <a href="#form" class="btn btn-outline">Получить презентацию</a>
            </div>
          </div>
          <% const featuredHouse = homeHouses[0]; %>
          <% if (featuredHouse) { %>
            <a href="/houses/<%= encodeURIComponent(featuredHouse.id) %>" class="hero-project">
              <img src="<%= projectMedia(featuredHouse).cover %>" alt="" width="104" height="104" decoding="async">
              <div class="hero-project__copy">
                <strong><%= featuredHouse.title %></strong>
                <% if (featuredHouse.area) { %><span><%= featuredHouse.area %></span><% } %>
                <span class="hero-project__link">Смотреть проект <span aria-hidden="true">→</span></span>
              </div>
            </a>
          <% } %>
        </div>
        <% if (hero.illustrated) { %><span class="media-caption">Архитектурная визуализация</span><% } %>
      </div>
      <nav class="home-shortcuts" aria-label="Выбор и строительство дома">
        <ul class="container">
          <li><a href="/calculator"><span><strong>Подбор проекта</strong><span>По площади и нужным характеристикам</span></span><span aria-hidden="true">→</span></a></li>
          <li><a href="/individual-planning"><span><strong>Индивидуальное проектирование</strong><span>Планировка и фасады под ваш участок</span></span><span aria-hidden="true">→</span></a></li>
          <li><a href="/stages"><span><strong>Этапы стройки</strong><span>От подготовки участка до отделки</span></span><span aria-hidden="true">→</span></a></li>
        </ul>
      </nav>
    </section>

    <% if (homeHouses.length) { %>
      <section id="houses" class="houses container home-projects" aria-labelledby="home-projects-title">
        <div class="home-section-head home-projects__head">
          <h2 class="section-title" id="home-projects-title"><%= homeHeadings.projects %></h2>
          <div class="home-projects__actions">
            <a href="/projects" class="home-projects__all">Все проекты <span aria-hidden="true">↗</span></a>
            <% if (homeHouses.length > 1) { %>
              <div class="home-projects__controls" hidden>
                <button class="home-projects__arrow" type="button" data-project-step="-1" aria-controls="home-projects-track" aria-label="Предыдущий проект"><span aria-hidden="true">←</span></button>
                <button class="home-projects__arrow home-projects__arrow--next" type="button" data-project-step="1" aria-controls="home-projects-track" aria-label="Следующий проект"><span aria-hidden="true">→</span></button>
              </div>
            <% } %>
          </div>
        </div>
        <div class="home-projects__track" id="home-projects-track" role="group" aria-label="Карточки проектов">
          <% homeHouses.forEach(function(house) { %>
            <%- include('partials/project-card', { house, showDescription: true }) %>
          <% }); %>
        </div>
        <% if (homeHouses.length > 1) { %>
          <div class="home-projects__pagination" hidden>
            <div class="home-projects__positions" role="group" aria-label="Выбор позиции"></div>
            <span class="home-projects__position" aria-live="polite" aria-atomic="true"></span>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (homeStages.length) { %>
      <section class="home-stages" aria-labelledby="home-stages-title">
        <div class="container">
          <div class="home-section-head">
            <div>
              <h2 class="section-title" id="home-stages-title"><%= homeHeadings.stages %></h2>
              <p>Посмотрите, какие работы выполняются на каждом этапе строительства.</p>
            </div>
            <a href="/stages" class="btn btn-outline">Все этапы <span aria-hidden="true">→</span></a>
          </div>
          <div class="home-stages-grid">
            <% homeStages.forEach(function(stage) { %>
              <a class="home-stage" href="/stages#stage-<%= encodeURIComponent(stage.id) %>">
                <% if (stage.cover) { %>
                  <span class="home-stage__media">
                    <img src="<%= stage.cover.src %>" alt="" loading="lazy">
                    <% if (stage.cover.kind === 'illustration') { %><span class="media-caption">Иллюстрация</span><% } %>
                  </span>
                <% } %>
                <span class="home-stage__title"><%= stage.title %><span aria-hidden="true">→</span></span>
              </a>
            <% }); %>
          </div>
        </div>
      </section>
    <% } %>

    <section class="home-design container" aria-labelledby="home-design-title">
      <div class="home-design__layout">
        <div class="home-design__copy">
          <h2 class="section-title" id="home-design-title"><%= homeHeadings.design %></h2>
          <% if (design.text) { %><p><%= design.text %></p><% } %>
          <a href="/individual-planning" class="btn btn-accent">О проектировании <span aria-hidden="true">→</span></a>
        </div>
        <img src="<%= design.image %>" alt="" width="1000" height="750" loading="lazy">
      </div>
    </section>

    <% if (homePortfolio.length) { %>
      <section class="home-portfolio container" aria-labelledby="home-portfolio-title">
        <div class="home-section-head">
          <div>
            <h2 class="section-title" id="home-portfolio-title"><%= homeHeadings.portfolio %></h2>
            <p>Объекты с описанием, фотографиями или визуализациями и данными о проекте.</p>
          </div>
          <a href="/portfolio" class="btn btn-outline">Всё портфолио <span aria-hidden="true">→</span></a>
        </div>
        <div class="houses-grid<%= homePortfolio.length === 1 ? ' portfolio-grid--featured' : '' %>">
          <% homePortfolio.forEach(function(item) { %>
            <%- include('partials/portfolio-card', { item, showAddress: true }) %>
          <% }); %>
        </div>
      </section>
    <% } %>

    <section id="advantages" class="advantages" aria-labelledby="home-advantages-title">
      <div class="container">
        <h2 class="section-title" id="home-advantages-title"><%= homeHeadings.advantages %></h2>
        <div class="advantages-grid">
          <% advantages.forEach(function(adv) { %>
            <div class="advantage-card">
              <% if (adv.image) { %><img class="advantage-icon" src="<%= adv.image %>" alt="" loading="lazy"><% } %>
              <h3><%= adv.title %></h3>
              <p><%= adv.text %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <%- include('partials/lead-cta', {
      ctaTitle: homeHeadings.request,
      ctaText: 'Оставьте заявку — пришлём планировки, цены и сроки строительства по каждому дому из подборки.',
      returnTo: '/',
    }) %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <% if (homeHouses.length > 1) { %><script src="/js/home-projects.js" defer></script><% } %>
  <script src="/js/form-validation.js"></script>
</body>
</html>

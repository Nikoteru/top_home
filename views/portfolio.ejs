<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Портфолио — <%= content.hero.title %></title>
  <meta name="description" content="Построенные нами дома: фотографии, стоимость и расположение объектов.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <section class="container projects-page">
    <nav class="breadcrumb">
      <a href="/">Главная</a> <span>/</span> <span>Портфолио</span>
    </nav>

    <div class="projects-head">
      <div>
        <h1>Портфолио</h1>
        <p class="projects-count">Дома, которые мы уже построили, — с фотографиями, стоимостью и адресом.</p>
      </div>
    </div>

    <% if (items.length === 0) { %>
      <p class="projects-empty">Скоро здесь появятся наши реализованные объекты.</p>
    <% } else { %>
      <div class="houses-grid">
        <% items.forEach(function(item) { var photos = item.photos || []; %>
          <article class="house-card portfolio-card">
            <a href="/portfolio/<%= item.id %>" class="house-card__image" style="background-image:url('<%= photos[0] || '/images/placeholder-new.svg' %>')" aria-label="<%= item.title %>">
              <% if (photos.length > 0) { %><span class="portfolio-card__count"><%= photos.length %> фото</span><% } %>
            </a>
            <div class="house-card__body">
              <h3><a href="/portfolio/<%= item.id %>" class="house-card__title-link"><%= item.title %></a></h3>
              <% if (item.price) { %><div class="house-card__meta"><span><%= item.price %></span></div><% } %>
              <% if (item.address) { %><p class="portfolio-card__address"><%= item.address %></p><% } %>
              <a href="/portfolio/<%= item.id %>" class="btn btn-outline">Смотреть объект</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>

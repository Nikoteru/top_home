<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Портфолио — <%= content.hero.title %></title>
  <meta name="description" content="Построенные нами дома: фотографии, стоимость и расположение объектов.">
  <%- include('partials/public-styles') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container projects-page">
    <nav class="breadcrumb">
      <a href="/">Главная</a> <span>/</span> <span>Портфолио</span>
    </nav>

    <div class="projects-head">
      <div>
        <h1>Портфолио</h1>
        <p class="projects-count">Дома, которые мы уже построили, — с фотографиями, стоимостью и адресом.</p>
      </div>
    </div>

    <% if (items.length === 0) { %>
      <p class="projects-empty">Скоро здесь появятся наши реализованные объекты.</p>
    <% } else { %>
      <div class="houses-grid<%= items.length === 1 ? ' portfolio-grid--featured' : '' %>">
        <% items.forEach(function(item) { %>
          <%- include('partials/portfolio-card', { item, showAddress: true }) %>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer', { formTarget: '/#form' }) %>

  <script src="/js/main.js"></script>
</body>
</html>

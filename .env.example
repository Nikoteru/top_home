# Скопируйте этот файл в .env и поменяйте значения перед запуском!

# Логин и пароль для входа в админку (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-123

# Любая случайная длинная строка — секрет для подписи сессий
SESSION_SECRET=super-secret-session-key-please-change

# Порт, на котором запустится сайт
PORT=3000

# URL PostgreSQL базы сайта. При пустом значении сайт использует JSON-файлы.
DATABASE_URL=
# DATA_STORE=postgres можно использовать с PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD.
